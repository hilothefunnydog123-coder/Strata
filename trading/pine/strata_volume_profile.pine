//@version=6
//
// Strata session volume profile. The chart half of the system.
//
// This draws exactly what strata_vp computes: the previous session's volume
// profile, the current session's developing profile, unfilled fair value gaps,
// and the arm and trigger states of the strategy. It exists so that a signal
// the Python engine takes can be looked at, and so that a signal it did not
// take can be understood.
//
// Read this before relying on it for anything live:
//
//   This is the live half of the system, not a decoration. The Python engine
//   has no broker API to trade through, so it is the backtester that decides
//   the parameters, and this script is what runs during the session and tells
//   you the trade. Every number it draws is computed the same way the engine
//   computes it, including the reward to risk test, so a setup the engine
//   would have rejected is not drawn here either.
//
//   TradingView cannot send a webhook on the free plan. Alerts that call a URL
//   are a paid feature. On a free account the alertcondition messages below
//   reach a popup and an email, which is enough: they carry the entry, the
//   stop and the targets, so the trade can be placed from the alert itself.
//
//   One simplification against the Python engine, stated so it is not
//   discovered as a surprise: the engine requires the trigger gap to overlap a
//   band running from the level to the current price, while this script only
//   tracks the most recent unfilled gap of each direction. In practice the two
//   agree, because a gap that is still unfilled and less than forty bars old
//   while price sits between the level and the point of control is almost
//   always inside that band. It is a divergence all the same.
//
//   A profile built from chart bars is not a profile built from ticks. Volume
//   inside a bar is distributed across the bar's range, which is the same
//   assumption the Python side makes, and is why both should be run on one
//   minute bars when the numbers matter.
//
//   Session strings are wall clock in the timezone below, so daylight saving
//   is handled by TradingView rather than by arithmetic here.

indicator("Strata Session Volume Profile", overlay = true,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ---------------------------------------------------------------- inputs ---

grpSession = "Sessions"
tzName = input.string("America/Los_Angeles", "Timezone", group = grpSession)
tradeSpec = input.session("0630-1300", "Session traded", group = grpSession,
     tooltip = "New York cash by default. Asia is 1700-0100, London is 0000-0630.")
refSpec = input.session("0300-0630", "Reference session", group = grpSession,
     tooltip = "The window whose profile the traded session is graded against. " +
     "0300-0630 is the brief as written. 1700-0630 is the full overnight.")

grpProfile = "Profile"
rowCount = input.int(48, "Rows", minval = 12, maxval = 160, group = grpProfile)
vaShare = input.float(70.0, "Value area percent", minval = 50.0, maxval = 95.0,
     group = grpProfile) / 100.0
showDeveloping = input.bool(true, "Developing profile", group = grpProfile)
drawSessions = input.int(10, "Sessions to draw", minval = 1, maxval = 60,
     group = grpProfile, tooltip = "Older sessions are skipped to keep the " +
     "script inside TradingView's execution budget.")

grpSetup = "Setup"
minGapPoints = input.float(2.0, "Minimum fair value gap, points", minval = 0.0, group = grpSetup)
armBars = input.int(20, "Arm stays valid for, bars", minval = 1, group = grpSetup)
gapMaxAge = input.int(40, "Gap stays valid for, bars", minval = 1, group = grpSetup)
warmupBars = input.int(6, "Bars into session before arming", minval = 0, group = grpSetup)
stopBuffer = input.float(10.0, "Stop, points past the gap", minval = 0.25, group = grpSetup)
minRewardRisk = input.float(1.0, "Minimum reward to risk", minval = 0.1, group = grpSetup)
minStopAtr = input.float(1.5, "Minimum stop, multiples of ATR", minval = 0.0, group = grpSetup,
     tooltip = "Ten points past a five point gap is a thirteen point stop, and " +
     "the median five minute bar is eleven points wide. Without a floor the stop " +
     "sits inside one bar of noise and gets taken out by nothing.")

grpStyle = "Style"
pocColour = input.color(color.new(#e0a800, 0), "Point of control", group = grpStyle)
vaColour = input.color(color.new(#4a90d9, 0), "Value area", group = grpStyle)
devColour = input.color(color.new(#7f8c8d, 30), "Developing", group = grpStyle)
bullGapColour = input.color(color.new(#1e8449, 82), "Bullish gap", group = grpStyle)
bearGapColour = input.color(color.new(#a93226, 82), "Bearish gap", group = grpStyle)
showTicketBoxes = input.bool(true, "Draw the position boxes", group = grpStyle)
showStatus = input.bool(true, "Show the status readout", group = grpStyle)
ticketWidth = input.int(14, "Position box width, bars", minval = 2, group = grpStyle)
tpBoxColour = input.color(color.new(#26a69a, 78), "Target box", group = grpStyle)
runBoxColour = input.color(color.new(#26a69a, 89), "Runner box", group = grpStyle)
slBoxColour = input.color(color.new(#ef5350, 78), "Stop box", group = grpStyle)

// --------------------------------------------------------------- sessions ---

inTrade = not na(time(timeframe.period, tradeSpec, tzName))
inRef = not na(time(timeframe.period, refSpec, tzName))

tradeOpen = inTrade and not inTrade[1]
refClose = not inRef and inRef[1]

var int refBars = 0
if inRef
    refBars := inRef[1] ? refBars + 1 : 1

var int sessionBars = 0
sessionBars := tradeOpen ? 1 : inTrade ? sessionBars + 1 : 0

// Skip the arithmetic on old bars. The double loop below is cheap per bar and
// expensive over ten years of them, and TradingView will stop the script rather
// than run it slowly.
recent = (last_bar_index - bar_index) < drawSessions * 500

// ---------------------------------------------------------------- profile ---

// Volume distributed across each bar's range, then the standard value area:
// start at the point of control and add whichever pair of rows, above or
// below, holds more volume, until the requested share is inside.
calcProfile(int startOffset, int length, int rows, float share) =>
    float hi = na
    float lo = na
    if length > 0
        for i = startOffset to startOffset + length - 1
            hi := na(hi) ? high[i] : math.max(hi, high[i])
            lo := na(lo) ? low[i] : math.min(lo, low[i])
    float step = na(hi) or hi <= lo ? na : (hi - lo) / rows
    float poc = na
    float vah = na
    float val = na
    if not na(step) and step > 0
        buckets = array.new<float>(rows, 0.0)
        float total = 0.0
        for i = startOffset to startOffset + length - 1
            float bh = high[i]
            float bl = low[i]
            float bv = volume[i]
            if bv > 0
                int r1 = math.max(0, math.min(rows - 1, int(math.floor((bl - lo) / step))))
                int r2 = math.max(0, math.min(rows - 1, int(math.floor((bh - lo) / step))))
                if r1 == r2 or bh <= bl
                    array.set(buckets, r1, array.get(buckets, r1) + bv)
                else
                    float span = bh - bl
                    for r = r1 to r2
                        float rowLow = lo + r * step
                        float overlap = math.min(bh, rowLow + step) - math.max(bl, rowLow)
                        if overlap > 0
                            array.set(buckets, r, array.get(buckets, r) + bv * overlap / span)
                total += bv

        if total > 0
            int pocRow = 0
            float best = -1.0
            for r = 0 to rows - 1
                float v = array.get(buckets, r)
                if v > best
                    best := v
                    pocRow := r

            int upper = pocRow
            int lower = pocRow
            float inside = best
            float target = total * share
            bool more = true
            while inside < target and more
                bool canUp = upper < rows - 1
                bool canDown = lower > 0
                if not canUp and not canDown
                    more := false
                else
                    int upStep = canUp ? math.min(2, rows - 1 - upper) : 0
                    int downStep = canDown ? math.min(2, lower) : 0
                    float upVol = -1.0
                    float downVol = -1.0
                    if upStep > 0
                        upVol := 0.0
                        for k = 1 to upStep
                            upVol += array.get(buckets, upper + k)
                    if downStep > 0
                        downVol := 0.0
                        for k = 1 to downStep
                            downVol += array.get(buckets, lower - k)
                    if upStep > 0 and upVol >= downVol
                        inside += upVol
                        upper += upStep
                    else if downStep > 0
                        inside += downVol
                        lower -= downStep
                    else
                        more := false

            poc := lo + (pocRow + 0.5) * step
            vah := lo + (upper + 1) * step
            val := lo + lower * step
    [poc, vah, val]

var float refPoc = na
var float refVah = na
var float refVal = na

// The reference profile is finished the moment its window closes, and is then
// held fixed for the whole traded session. Recomputing it while trading would
// move every level underneath an open position.
if refClose and recent
    [p, h, l] = calcProfile(1, refBars[1], rowCount, vaShare)
    refPoc := p
    refVah := h
    refVal := l

var float devPoc = na
var float devVah = na
var float devVal = na

if inTrade and recent and sessionBars > 2
    [p, h, l] = calcProfile(0, sessionBars, rowCount, vaShare)
    devPoc := p
    devVah := h
    devVal := l
else if not inTrade
    devPoc := na
    devVah := na
    devVal := na

plot(inTrade ? refPoc : na, "Reference POC", pocColour, 2, plot.style_linebr)
plot(inTrade ? refVah : na, "Reference VAH", vaColour, 1, plot.style_linebr)
plot(inTrade ? refVal : na, "Reference VAL", vaColour, 1, plot.style_linebr)
plot(inTrade and showDeveloping ? devVah : na, "Developing VAH", devColour, 1, plot.style_linebr)
plot(inTrade and showDeveloping ? devVal : na, "Developing VAL", devColour, 1, plot.style_linebr)

// ------------------------------------------------------- fair value gaps ---

// Only the most recent unfilled gap of each direction is tracked, because that
// is the only one the strategy trades. Older ones are drawn and forgotten.
var float bullTop = na
var float bullBottom = na
var int bullBar = na
var float bearTop = na
var float bearBottom = na
var int bearBar = na

newBull = low > high[2] and (low - high[2]) >= minGapPoints
newBear = high < low[2] and (low[2] - high) >= minGapPoints

if newBull
    bullTop := low
    bullBottom := high[2]
    bullBar := bar_index
    if recent
        box.new(bar_index - 2, low, bar_index + 8, high[2], border_color = na, bgcolor = bullGapColour)

if newBear
    bearTop := low[2]
    bearBottom := high
    bearBar := bar_index
    if recent
        box.new(bar_index - 2, low[2], bar_index + 8, high, border_color = na, bgcolor = bearGapColour)

// Fill tracking. A gap is spent once price has traded most of the way back
// through it, and expires with age regardless.
bullSize = nz(bullTop - bullBottom, 0)
bullFilled = bullSize > 0 ? math.max(0, math.min(1, (bullTop - low) / bullSize)) : 1
bearSize = nz(bearTop - bearBottom, 0)
bearFilled = bearSize > 0 ? math.max(0, math.min(1, (high - bearBottom) / bearSize)) : 1

var float bullWorstFill = 0.0
var float bearWorstFill = 0.0
bullWorstFill := newBull ? 0.0 : math.max(bullWorstFill, bullFilled)
bearWorstFill := newBear ? 0.0 : math.max(bearWorstFill, bearFilled)

bullAlive = not na(bullTop) and bullWorstFill < 0.5 and (bar_index - bullBar) <= gapMaxAge
bearAlive = not na(bearTop) and bearWorstFill < 0.5 and (bar_index - bearBar) <= gapMaxAge

if tradeOpen
    bullTop := na
    bearTop := na
    bullWorstFill := 0.0
    bearWorstFill := 0.0

// ----------------------------------------------------------------- setup ---

haveLevels = not na(refVal) and not na(refVah) and not na(devVal) and not na(devVah)

// An excursion has to actually reach the level. An earlier version allowed an
// approach to within an average true range of it, which counted price arriving
// ten points above the value area low as a sweep of it.
//
// And a sweep keeps the level in play for the rest of the session rather than
// for a fixed number of bars: the sweep happens in the first hour and the
// rotation is often taken hours later. A completed rotation is what spends it.
var bool sweptLow = false
var bool sweptHigh = false
if tradeOpen
    sweptLow := false
    sweptHigh := false

if inTrade and haveLevels
    if low <= refVal and low <= devVal
        sweptLow := true
    if high >= refVah and high >= devVah
        sweptHigh := true
    if close >= refPoc
        sweptLow := false
    if close <= refPoc
        sweptHigh := false

canArmLong = inTrade and haveLevels and sessionBars >= warmupBars and sweptLow and
     close > refVal and close < refPoc
canArmShort = inTrade and haveLevels and sessionBars >= warmupBars and sweptHigh and
     close < refVah and close > refPoc

var int armedLong = na
var int armedShort = na

armedLong := not inTrade ? na : canArmLong and na(armedLong) ? bar_index : armedLong
armedShort := not inTrade ? na : canArmShort and na(armedShort) ? bar_index : armedShort

longStale = not na(armedLong) and ((bar_index - armedLong) > armBars or close >= refPoc)
shortStale = not na(armedShort) and ((bar_index - armedShort) > armBars or close <= refPoc)

longTrigger = not na(armedLong) and not longStale and bullAlive and close < refPoc
shortTrigger = not na(armedShort) and not shortStale and bearAlive and close > refPoc

if longStale
    armedLong := na
if shortStale
    armedShort := na
if longTrigger
    armedLong := na
if shortTrigger
    armedShort := na

plotshape(canArmLong and na(armedLong[1]) ? low : na, "Armed long", shape.triangleup,
     location.absolute, color.new(#1e8449, 40), size = size.tiny)
plotshape(canArmShort and na(armedShort[1]) ? high : na, "Armed short", shape.triangledown,
     location.absolute, color.new(#a93226, 40), size = size.tiny)

// ------------------------------------------------------------ the ticket ---

// The trade, priced. Entry at consequent encroachment, the halfway line of the
// gap. Stop a fixed distance past the far edge, because if price closes the
// gap and keeps going the imbalance that was the reason for the trade is gone.
// First target the point of control, runner the far side of value.
entryPrice = longTrigger ? math.avg(bullTop, bullBottom) :
     shortTrigger ? math.avg(bearTop, bearBottom) : na
rawStop = longTrigger ? bullBottom - stopBuffer :
     shortTrigger ? bearTop + stopBuffer : na
// Push the stop out to the noise floor if the gap put it inside.
stopFloor = minStopAtr * nz(ta.atr(14), 0)
stopPrice = na(rawStop) ? na :
     longTrigger and (entryPrice - rawStop) < stopFloor ? entryPrice - stopFloor :
     shortTrigger and (rawStop - entryPrice) < stopFloor ? entryPrice + stopFloor : rawStop
targetPrice = longTrigger or shortTrigger ? refPoc : na
runnerPrice = longTrigger ? refVah : shortTrigger ? refVal : na

riskPoints = math.abs(entryPrice - stopPrice)
blendedReward = na(runnerPrice) ? math.abs(targetPrice - entryPrice) :
     0.5 * math.abs(targetPrice - entryPrice) + 0.5 * math.abs(runnerPrice - entryPrice)
rewardRisk = riskPoints > 0 ? blendedReward / riskPoints : 0.0

// The same geometry test the engine applies. A setup that cannot pay for its
// own stop is not drawn, so the chart and the backtest agree about what counts
// as a signal rather than the chart being the optimistic one.
longTicket = longTrigger and rewardRisk >= minRewardRisk and targetPrice > entryPrice
shortTicket = shortTrigger and rewardRisk >= minRewardRisk and targetPrice < entryPrice

// The same picture the strategy draws: green from the entry up to the point of
// control, a paler green on to the far side of value, red from the entry down
// to the stop. Boxes rather than lines because the thing worth seeing at a
// glance is the two areas, not the three prices.
if (longTicket or shortTicket) and showTicketBoxes
    box.new(bar_index, math.max(entryPrice, targetPrice), bar_index + ticketWidth,
         math.min(entryPrice, targetPrice), border_color = na, bgcolor = tpBoxColour)
    box.new(bar_index, math.max(entryPrice, stopPrice), bar_index + ticketWidth,
         math.min(entryPrice, stopPrice), border_color = na, bgcolor = slBoxColour)
    if not na(runnerPrice)
        box.new(bar_index, math.max(targetPrice, runnerPrice), bar_index + ticketWidth,
             math.min(targetPrice, runnerPrice), border_color = na, bgcolor = runBoxColour)
    line.new(bar_index, entryPrice, bar_index + ticketWidth, entryPrice,
         color = color.new(#787b86, 0), width = 1, style = line.style_dashed)
    label.new(bar_index + ticketWidth, entryPrice,
         (longTicket ? "LONG " : "SHORT ") + str.tostring(entryPrice, format.mintick) +
         "\nstop " + str.tostring(stopPrice, format.mintick) +
         "  (" + str.tostring(riskPoints, "#.##") + " pt)" +
         "\ntgt  " + str.tostring(targetPrice, format.mintick) +
         "\nrun  " + str.tostring(runnerPrice, format.mintick) +
         "\nR:R  " + str.tostring(rewardRisk, "#.##"),
         style = label.style_label_left,
         color = longTicket ? color.new(#1e8449, 0) : color.new(#a93226, 0),
         textcolor = color.white, size = size.small)

plotshape(longTicket ? low : na, "Long ticket", shape.labelup, location.belowbar,
     color.new(#1e8449, 0), text = "L", textcolor = color.white, size = size.small)
plotshape(shortTicket ? high : na, "Short ticket", shape.labeldown, location.abovebar,
     color.new(#a93226, 0), text = "S", textcolor = color.white, size = size.small)

// ---------------------------------------------------------------- alerts ---

// On the free plan these reach a popup and an email, not a webhook. That is
// the whole live path for an account with no broker API, so the message has to
// carry the prices: an alert saying "setup" and nothing else means opening the
// chart to find out what it meant, by which time the limit is gone.
// The prices are published as named hidden plots so the alert text can
// interpolate them. {{plot_0}} would have resolved to the reference point of
// control, which is the first plot in the script and not what anyone wants to
// read in an email at 06:47.
plot(longTicket or shortTicket ? entryPrice : na, "Entry", display = display.none)
plot(longTicket or shortTicket ? stopPrice : na, "Stop", display = display.none)
plot(longTicket or shortTicket ? targetPrice : na, "Target", display = display.none)
plot(longTicket or shortTicket ? runnerPrice : na, "Runner", display = display.none)

alertcondition(longTicket, "Volume profile long",
     'LONG {{ticker}} limit {{plot("Entry")}} stop {{plot("Stop")}} ' +
     'target {{plot("Target")}} runner {{plot("Runner")}}. ' +
     'Swept the value area low, reclaimed, gap in the zone.')
alertcondition(shortTicket, "Volume profile short",
     'SHORT {{ticker}} limit {{plot("Entry")}} stop {{plot("Stop")}} ' +
     'target {{plot("Target")}} runner {{plot("Runner")}}. ' +
     'Swept the value area high, rejected, gap in the zone.')

// Paid plans only. The payload matches what notify.py emits so a webhook can
// feed the same ticket into Discord or Telegram without reformatting.
if longTicket or shortTicket
    alert('{"side":"' + (longTicket ? "long" : "short") +
         '","symbol":"' + syminfo.ticker +
         '","entry":' + str.tostring(entryPrice) +
         ',"stop":' + str.tostring(stopPrice) +
         ',"target":' + str.tostring(targetPrice) +
         ',"runner":' + str.tostring(runnerPrice) +
         ',"risk_points":' + str.tostring(riskPoints) +
         ',"reward_risk":' + str.tostring(rewardRisk) +
         ',"poc":' + str.tostring(refPoc) +
         ',"vah":' + str.tostring(refVah) +
         ',"val":' + str.tostring(refVal) + '}', alert.freq_once_per_bar_close)

// ----------------------------------------------------------------- table ---

// A status readout, because the usual question about this script is not "what
// is the point of control" but "why has it not drawn anything today". Every
// condition that has to be true for a ticket is listed, so the one that is
// false is visible rather than guessed at.
//
// The table and both helpers are declared at global scope. Pine will not
// accept a function declared inside an `if`, which is easy to write and fails
// with a message that does not say so.

tick(bool ok) => ok ? "yes" : "no"

statusRow(table board, int slot, string name, string value, color shade) =>
    table.cell(board, 0, slot, name, text_size = size.tiny,
         text_halign = text.align_left, text_color = color.new(#d1d4dc, 0))
    table.cell(board, 1, slot, value, text_size = size.tiny,
         text_halign = text.align_right, text_color = shade)

var table readout = table.new(position.top_right, 2, 12, border_width = 1,
     bgcolor = color.new(#1e222d, 10), frame_color = color.new(#787b86, 40),
     frame_width = 1)

if barstate.islast and showStatus
    good = color.new(#26a69a, 0)
    bad = color.new(#ef5350, 0)
    dim = color.new(#787b86, 0)
    statusRow(readout, 0, "in session", tick(inTrade), inTrade ? good : dim)
    statusRow(readout, 1, "levels ready", tick(haveLevels), haveLevels ? good : bad)
    statusRow(readout, 2, "reference VAH",
         na(refVah) ? "waiting" : str.tostring(refVah, format.mintick), dim)
    statusRow(readout, 3, "reference POC",
         na(refPoc) ? "waiting" : str.tostring(refPoc, format.mintick), dim)
    statusRow(readout, 4, "reference VAL",
         na(refVal) ? "waiting" : str.tostring(refVal, format.mintick), dim)
    statusRow(readout, 5, "developing VAL",
         na(devVal) ? "waiting" : str.tostring(devVal, format.mintick), dim)
    statusRow(readout, 6, "bars into session",
         str.tostring(sessionBars) + " / " + str.tostring(warmupBars),
         sessionBars >= warmupBars ? good : bad)
    statusRow(readout, 7, "swept low / high", tick(sweptLow) + " / " + tick(sweptHigh),
         sweptLow or sweptHigh ? good : bad)
    statusRow(readout, 8, "armed long / short",
         tick(not na(armedLong)) + " / " + tick(not na(armedShort)),
         not na(armedLong) or not na(armedShort) ? good : dim)
    statusRow(readout, 9, "gap live long / short", tick(bullAlive) + " / " + tick(bearAlive),
         bullAlive or bearAlive ? good : bad)
    statusRow(readout, 10, "reward to risk",
         rewardRisk > 0 ? str.tostring(rewardRisk, "#.##") : "no setup",
         rewardRisk >= minRewardRisk ? good : dim)
    statusRow(readout, 11, "ticket",
         longTicket ? "LONG" : shortTicket ? "SHORT" : "none",
         longTicket or shortTicket ? good : dim)
