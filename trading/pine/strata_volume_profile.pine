//@version=6
//
// Strata session volume profile. The chart half of the system.
//
// This draws exactly what strata_vp computes: the previous session's volume
// profile, the current session's developing profile, unfilled fair value gaps,
// and the arm and trigger states of the strategy. It exists so that a signal
// the Python engine takes can be looked at, and so that a signal it did not
// take can be understood.
//
// Read this before relying on it for anything live:
//
//   TradingView cannot send a webhook on the free plan. Alerts that call a URL
//   are a paid feature. The alertcondition calls below will fire a popup and an
//   email on a free account, and that is all. The engine does not depend on
//   them. If you do have a paid plan, the alert() calls carry a JSON payload
//   the engine can consume, but the supported path is the engine reading bars
//   from the broker directly, because an alert that arrives late or not at all
//   is worse than no alert.
//
//   A profile built from chart bars is not a profile built from ticks. Volume
//   inside a bar is distributed across the bar's range, which is the same
//   assumption the Python side makes, and is why both should be run on one
//   minute bars when the numbers matter.
//
//   Session strings are wall clock in the timezone below, so daylight saving
//   is handled by TradingView rather than by arithmetic here.

indicator("Strata Session Volume Profile", overlay = true,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ---------------------------------------------------------------- inputs ---

grpSession = "Sessions"
tzName = input.string("America/Los_Angeles", "Timezone", group = grpSession)
tradeSpec = input.session("0630-1300", "Session traded", group = grpSession,
     tooltip = "New York cash by default. Asia is 1700-0100, London is 0000-0630.")
refSpec = input.session("0300-0630", "Reference session", group = grpSession,
     tooltip = "The window whose profile the traded session is graded against. " +
     "0300-0630 is the brief as written. 1700-0630 is the full overnight.")

grpProfile = "Profile"
rowCount = input.int(48, "Rows", minval = 12, maxval = 160, group = grpProfile)
vaShare = input.float(70.0, "Value area percent", minval = 50.0, maxval = 95.0,
     group = grpProfile) / 100.0
showDeveloping = input.bool(true, "Developing profile", group = grpProfile)
drawSessions = input.int(10, "Sessions to draw", minval = 1, maxval = 60,
     group = grpProfile, tooltip = "Older sessions are skipped to keep the " +
     "script inside TradingView's execution budget.")

grpSetup = "Setup"
minGapPoints = input.float(2.0, "Minimum fair value gap, points", minval = 0.0, group = grpSetup)
excursionBars = input.int(20, "Excursion stays valid for, bars", minval = 1, group = grpSetup)
armBars = input.int(12, "Arm stays valid for, bars", minval = 1, group = grpSetup)
gapMaxAge = input.int(40, "Gap stays valid for, bars", minval = 1, group = grpSetup)
warmupBars = input.int(15, "Bars into session before arming", minval = 0, group = grpSetup)

grpStyle = "Style"
pocColour = input.color(color.new(#e0a800, 0), "Point of control", group = grpStyle)
vaColour = input.color(color.new(#4a90d9, 0), "Value area", group = grpStyle)
devColour = input.color(color.new(#7f8c8d, 30), "Developing", group = grpStyle)
bullGapColour = input.color(color.new(#1e8449, 82), "Bullish gap", group = grpStyle)
bearGapColour = input.color(color.new(#a93226, 82), "Bearish gap", group = grpStyle)

// --------------------------------------------------------------- sessions ---

inTrade = not na(time(timeframe.period, tradeSpec, tzName))
inRef = not na(time(timeframe.period, refSpec, tzName))

tradeOpen = inTrade and not inTrade[1]
refClose = not inRef and inRef[1]

var int refBars = 0
if inRef
    refBars := inRef[1] ? refBars + 1 : 1

var int sessionBars = 0
sessionBars := tradeOpen ? 1 : inTrade ? sessionBars + 1 : 0

// Skip the arithmetic on old bars. The double loop below is cheap per bar and
// expensive over ten years of them, and TradingView will stop the script rather
// than run it slowly.
recent = (last_bar_index - bar_index) < drawSessions * 500

// ---------------------------------------------------------------- profile ---

// Volume distributed across each bar's range, then the standard value area:
// start at the point of control and add whichever pair of rows, above or
// below, holds more volume, until the requested share is inside.
calcProfile(int startOffset, int length, int rows, float share) =>
    float hi = na
    float lo = na
    if length > 0
        for i = startOffset to startOffset + length - 1
            hi := na(hi) ? high[i] : math.max(hi, high[i])
            lo := na(lo) ? low[i] : math.min(lo, low[i])
    float step = na(hi) or hi <= lo ? na : (hi - lo) / rows
    float poc = na
    float vah = na
    float val = na
    if not na(step) and step > 0
        buckets = array.new<float>(rows, 0.0)
        float total = 0.0
        for i = startOffset to startOffset + length - 1
            float bh = high[i]
            float bl = low[i]
            float bv = volume[i]
            if bv > 0
                int r1 = math.max(0, math.min(rows - 1, int(math.floor((bl - lo) / step))))
                int r2 = math.max(0, math.min(rows - 1, int(math.floor((bh - lo) / step))))
                if r1 == r2 or bh <= bl
                    array.set(buckets, r1, array.get(buckets, r1) + bv)
                else
                    float span = bh - bl
                    for r = r1 to r2
                        float rowLow = lo + r * step
                        float overlap = math.min(bh, rowLow + step) - math.max(bl, rowLow)
                        if overlap > 0
                            array.set(buckets, r, array.get(buckets, r) + bv * overlap / span)
                total += bv

        if total > 0
            int pocRow = 0
            float best = -1.0
            for r = 0 to rows - 1
                float v = array.get(buckets, r)
                if v > best
                    best := v
                    pocRow := r

            int upper = pocRow
            int lower = pocRow
            float inside = best
            float target = total * share
            bool more = true
            while inside < target and more
                bool canUp = upper < rows - 1
                bool canDown = lower > 0
                if not canUp and not canDown
                    more := false
                else
                    int upStep = canUp ? math.min(2, rows - 1 - upper) : 0
                    int downStep = canDown ? math.min(2, lower) : 0
                    float upVol = -1.0
                    float downVol = -1.0
                    if upStep > 0
                        upVol := 0.0
                        for k = 1 to upStep
                            upVol += array.get(buckets, upper + k)
                    if downStep > 0
                        downVol := 0.0
                        for k = 1 to downStep
                            downVol += array.get(buckets, lower - k)
                    if upStep > 0 and upVol >= downVol
                        inside += upVol
                        upper += upStep
                    else if downStep > 0
                        inside += downVol
                        lower -= downStep
                    else
                        more := false

            poc := lo + (pocRow + 0.5) * step
            vah := lo + (upper + 1) * step
            val := lo + lower * step
    [poc, vah, val]

var float refPoc = na
var float refVah = na
var float refVal = na

// The reference profile is finished the moment its window closes, and is then
// held fixed for the whole traded session. Recomputing it while trading would
// move every level underneath an open position.
if refClose and recent
    [p, h, l] = calcProfile(1, refBars[1], rowCount, vaShare)
    refPoc := p
    refVah := h
    refVal := l

var float devPoc = na
var float devVah = na
var float devVal = na

if inTrade and showDeveloping and recent and sessionBars > 2
    [p, h, l] = calcProfile(0, sessionBars, rowCount, vaShare)
    devPoc := p
    devVah := h
    devVal := l
else if not inTrade
    devPoc := na
    devVah := na
    devVal := na

plot(inTrade ? refPoc : na, "Reference POC", pocColour, 2, plot.style_linebr)
plot(inTrade ? refVah : na, "Reference VAH", vaColour, 1, plot.style_linebr)
plot(inTrade ? refVal : na, "Reference VAL", vaColour, 1, plot.style_linebr)
plot(inTrade and showDeveloping ? devVah : na, "Developing VAH", devColour, 1, plot.style_linebr)
plot(inTrade and showDeveloping ? devVal : na, "Developing VAL", devColour, 1, plot.style_linebr)

// ------------------------------------------------------- fair value gaps ---

// Only the most recent unfilled gap of each direction is tracked, because that
// is the only one the strategy trades. Older ones are drawn and forgotten.
var float bullTop = na
var float bullBottom = na
var int bullBar = na
var float bearTop = na
var float bearBottom = na
var int bearBar = na

newBull = low > high[2] and (low - high[2]) >= minGapPoints
newBear = high < low[2] and (low[2] - high) >= minGapPoints

if newBull
    bullTop := low
    bullBottom := high[2]
    bullBar := bar_index
    if recent
        box.new(bar_index - 2, low, bar_index + 8, high[2], border_color = na, bgcolor = bullGapColour)

if newBear
    bearTop := low[2]
    bearBottom := high
    bearBar := bar_index
    if recent
        box.new(bar_index - 2, low[2], bar_index + 8, high, border_color = na, bgcolor = bearGapColour)

// Fill tracking. A gap is spent once price has traded most of the way back
// through it, and expires with age regardless.
bullSize = nz(bullTop - bullBottom, 0)
bullFilled = bullSize > 0 ? math.max(0, math.min(1, (bullTop - low) / bullSize)) : 1
bearSize = nz(bearTop - bearBottom, 0)
bearFilled = bearSize > 0 ? math.max(0, math.min(1, (high - bearBottom) / bearSize)) : 1

var float bullWorstFill = 0.0
var float bearWorstFill = 0.0
bullWorstFill := newBull ? 0.0 : math.max(bullWorstFill, bullFilled)
bearWorstFill := newBear ? 0.0 : math.max(bearWorstFill, bearFilled)

bullAlive = not na(bullTop) and bullWorstFill < 0.5 and (bar_index - bullBar) <= gapMaxAge
bearAlive = not na(bearTop) and bearWorstFill < 0.5 and (bar_index - bearBar) <= gapMaxAge

if tradeOpen
    bullTop := na
    bearTop := na
    bullWorstFill := 0.0
    bearWorstFill := 0.0

// ----------------------------------------------------------------- setup ---

atr = ta.atr(14)
slack = math.max(4.0, 0.75 * nz(atr, 4.0))

haveLevels = not na(refVal) and not na(refVah) and not na(devVal) and not na(devVah)

var int refValTouch = na
var int refVahTouch = na
var int devValTouch = na
var int devVahTouch = na

if inTrade and haveLevels
    refValTouch := low <= refVal + slack ? bar_index : refValTouch
    refVahTouch := high >= refVah - slack ? bar_index : refVahTouch
    devValTouch := low <= devVal ? bar_index : devValTouch
    devVahTouch := high >= devVah ? bar_index : devVahTouch

fresh(int touched) => not na(touched) and (bar_index - touched) <= excursionBars

// Oversold on both profiles, then reclaimed, and the rotation not already over.
canArmLong = inTrade and haveLevels and sessionBars >= warmupBars and
     fresh(refValTouch) and fresh(devValTouch) and close > refVal and close < refPoc
canArmShort = inTrade and haveLevels and sessionBars >= warmupBars and
     fresh(refVahTouch) and fresh(devVahTouch) and close < refVah and close > refPoc

var int armedLong = na
var int armedShort = na

armedLong := not inTrade ? na : canArmLong and na(armedLong) ? bar_index : armedLong
armedShort := not inTrade ? na : canArmShort and na(armedShort) ? bar_index : armedShort

longStale = not na(armedLong) and ((bar_index - armedLong) > armBars or close >= refPoc)
shortStale = not na(armedShort) and ((bar_index - armedShort) > armBars or close <= refPoc)

longTrigger = not na(armedLong) and not longStale and bullAlive and close < refPoc
shortTrigger = not na(armedShort) and not shortStale and bearAlive and close > refPoc

if longStale
    armedLong := na
if shortStale
    armedShort := na
if longTrigger
    armedLong := na
if shortTrigger
    armedShort := na

plotshape(canArmLong and na(armedLong[1]) ? low : na, "Armed long", shape.triangleup,
     location.absolute, color.new(#1e8449, 40), size = size.tiny)
plotshape(canArmShort and na(armedShort[1]) ? high : na, "Armed short", shape.triangledown,
     location.absolute, color.new(#a93226, 40), size = size.tiny)
plotshape(longTrigger ? low : na, "Long trigger", shape.labelup, location.belowbar,
     color.new(#1e8449, 0), text = "L", textcolor = color.white, size = size.small)
plotshape(shortTrigger ? high : na, "Short trigger", shape.labeldown, location.abovebar,
     color.new(#a93226, 0), text = "S", textcolor = color.white, size = size.small)

// ---------------------------------------------------------------- alerts ---

alertcondition(longTrigger, "Volume profile long",
     "Long: oversold against both profiles, reclaimed, bullish gap in the zone. " +
     "Target the reference point of control.")
alertcondition(shortTrigger, "Volume profile short",
     "Short: overbought against both profiles, rejected, bearish gap in the zone. " +
     "Target the reference point of control.")

// Only reaches a webhook on a paid plan. The payload matches what the Python
// engine expects, so a paid account can drive the engine from the chart, and a
// free one can ignore this entirely and let the engine read bars itself.
if longTrigger or shortTrigger
    alert('{"side":"' + (longTrigger ? "long" : "short") +
         '","symbol":"' + syminfo.ticker +
         '","price":' + str.tostring(close) +
         ',"poc":' + str.tostring(refPoc) +
         ',"vah":' + str.tostring(refVah) +
         ',"val":' + str.tostring(refVal) + '}', alert.freq_once_per_bar_close)

// ----------------------------------------------------------------- table ---

if barstate.islast and haveLevels
    var table readout = table.new(position.top_right, 2, 5, border_width = 1)
    table.cell(readout, 0, 0, "Reference POC", text_size = size.tiny, text_halign = text.align_left)
    table.cell(readout, 1, 0, str.tostring(refPoc, format.mintick), text_size = size.tiny)
    table.cell(readout, 0, 1, "Reference VAH", text_size = size.tiny, text_halign = text.align_left)
    table.cell(readout, 1, 1, str.tostring(refVah, format.mintick), text_size = size.tiny)
    table.cell(readout, 0, 2, "Reference VAL", text_size = size.tiny, text_halign = text.align_left)
    table.cell(readout, 1, 2, str.tostring(refVal, format.mintick), text_size = size.tiny)
    table.cell(readout, 0, 3, "Developing VAH", text_size = size.tiny, text_halign = text.align_left)
    table.cell(readout, 1, 3, str.tostring(devVah, format.mintick), text_size = size.tiny)
    table.cell(readout, 0, 4, "Developing VAL", text_size = size.tiny, text_halign = text.align_left)
    table.cell(readout, 1, 4, str.tostring(devVal, format.mintick), text_size = size.tiny)
