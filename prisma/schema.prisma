// Ward — production data model. SQLite for a self-contained deploy; switch
// `provider` to "postgresql" and set DATABASE_URL to scale horizontally.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id         String             @id @default(cuid())
  name       String
  slug       String             @unique
  plan       String             @default("Enterprise")
  seededDemo Boolean            @default(false)
  active     Boolean            @default(true)
  createdAt  DateTime           @default(now())
  users      User[]
  systems    RegisteredSystem[]
  documents  SystemDocument[]
  apiKeys       ApiKey[]
  metrics       MetricPoint[]
  incidents     Incident[]
  validations   ValidationRun[]
  agentSessions AgentSession[]
  governance    GovernanceItem[]
  alertRules    AlertRule[]
  alerts        Alert[]
  auditEvents   AuditEvent[]
  roiRecords    RoiRecord[]
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String
  role         String        @default("Administrator")
  isOwner      Boolean       @default(false)
  active       Boolean       @default(true)
  orgId        String?
  org          Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  lastLoginAt  DateTime?
}

// A customer-registered AI system. `data` holds the registration input as JSON;
// the full control-center model is rebuilt from it by the same generator that
// powers the seeded estate.
model RegisteredSystem {
  id        String       @id
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  data      String
  createdAt DateTime     @default(now())
}

// Documentation attached to any system (seeded or registered), scoped to an org.
model SystemDocument {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  systemId  String
  name      String
  type      String
  status    String       @default("Draft")
  addedBy   String
  note      String?
  createdAt DateTime     @default(now())
}

// Per-org ingestion credential. Only the SHA-256 hash is stored; the plaintext
// key is shown to the customer exactly once at creation.
model ApiKey {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name       String
  prefix     String // human-visible key prefix, e.g. "wk_live_ab12"
  hash       String       @unique
  scopes     String       @default("ingest") // comma-separated
  createdBy  String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime     @default(now())

  @@index([orgId])
}

// A single real telemetry point pushed by a customer's model infrastructure
// (or written by the seed for the demo org). This is the ground truth the
// per-system health / performance / drift summaries are computed from.
model MetricPoint {
  id       String       @id @default(cuid())
  orgId    String
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  systemId String
  metric   String // accuracy | auroc | precision | recall | f1 | latency_ms | error_rate | volume | confidence | override_rate | drift | fairness_fnr_gap
  value    Float
  subgroup String? // for fairness metrics (e.g. "Female", "65+")
  ts       DateTime     @default(now())

  @@index([orgId, systemId, metric, ts])
}

model Incident {
  id             String          @id @default(cuid())
  orgId          String
  org            Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  systemId       String?
  systemName     String
  title          String
  severity       String // SEV-1..SEV-4
  status         String // Investigating | Contained | Monitoring | Resolved | Closed
  detectedBy     String
  owner          String
  description    String
  impact         String?
  affectedPeriod String?
  affectedPopulation String?
  suspectedCause String?
  rootCause      String?
  resolution     String?
  relatedVersion String?
  openedAt       DateTime        @default(now())
  resolvedAt     DateTime?
  events         IncidentEvent[]
  createdAt      DateTime        @default(now())

  @@index([orgId, status])
}

model IncidentEvent {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  at         DateTime @default(now())
  actor      String
  kind       String // detect | action | comment | status | deploy | resolve
  text       String
}

model ValidationRun {
  id          String    @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  systemId    String
  systemName  String
  version     String
  dataset     String
  datasetSize Int       @default(0)
  requestedBy String
  status      String // Queued | Running | Passed | Passed with warnings | Failed
  result      String // ValidationResult
  progress    Int       @default(100)
  tests       String    @default("[]") // JSON ValidationTest[]
  metrics     String    @default("[]") // JSON ValidationMetricResult[]
  subgroups   String    @default("[]") // JSON FairnessGroupMetric[]
  decision    String? // JSON { by, at, decision, comment }
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([orgId, systemId])
}

model AgentSession {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  systemId     String
  label        String
  subject      String
  status       String // Completed | Awaiting approval | Blocked | In progress
  outcome      String?
  riskFlags    String       @default("[]") // JSON string[]
  anomalyScore Float        @default(0)
  startedAt    DateTime     @default(now())
  endedAt      DateTime?
  events       AgentEvent[]
  createdAt    DateTime     @default(now())

  @@index([orgId, systemId])
}

model AgentEvent {
  id         String       @id @default(cuid())
  sessionId  String
  session    AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  step       Int
  at         DateTime     @default(now())
  kind       String
  summary    String
  detail     String?
  tool       String?
  dataSource String?
  status     String // normal | flagged | blocked | approved | pending
  durationMs Int?
  riskNote   String?
}

model GovernanceItem {
  id             String       @id @default(cuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  systemId       String?
  systemName     String
  category       String
  vendor         String
  riskLevel      String
  submittedBy    String
  currentStage   String
  status         String // Draft | In review | Blocked | Approved | Rejected
  steps          String       @default("[]") // JSON GovStep[]
  blockingReason String?
  targetGoLive   DateTime?
  submittedAt    DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([orgId, status])
}

model AlertRule {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  category  String
  metric    String
  op        String // gt | lt
  threshold Float
  severity  String
  enabled   Boolean      @default(true)
  createdAt DateTime     @default(now())

  @@index([orgId])
}

model Alert {
  id                String       @id @default(cuid())
  orgId             String
  org               Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  systemId          String?
  systemName        String
  category          String
  severity          String
  title             String
  detail            String?
  changeSummary     String?
  recommendedAction String?
  status            String       @default("Active") // Active | Acknowledged | Assigned | Muted | Escalated | Resolved
  owner             String?
  ruleId            String?
  linkTab           String?
  at                DateTime     @default(now())
  createdAt         DateTime     @default(now())

  @@index([orgId, status])
}

model AuditEvent {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  at        DateTime     @default(now())
  actor     String
  actorRole String
  action    String
  object    String
  systemId  String?
  category  String // Deployment | Version | Configuration | Approval | Validation | Incident | Access | Policy
  reason    String?

  @@index([orgId, at])
}

model RoiRecord {
  id                 String       @id @default(cuid())
  orgId              String
  org                Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  systemId           String
  annualImpact       Float        @default(0)
  implementationCost Float        @default(0)
  operatingCost      Float        @default(0)
  headlineLabel      String?
  headlineValue      String?
  breakdown          String       @default("[]") // JSON { label, value, unit }[]
  updatedBy          String?
  updatedAt          DateTime     @updatedAt
  createdAt          DateTime     @default(now())

  @@unique([orgId, systemId])
}
