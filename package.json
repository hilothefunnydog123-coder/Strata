{
  "name": "assent",
  "private": true,
  "version": "0.0.0",
  "description": "Assent \u2014 the queryable specification of US health-insurance coverage policy.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @assent/db run generate",
    "db:migrate": "pnpm --filter @assent/db run migrate",
    "db:seed": "tsx scripts/src/cli.ts seed",
    "ingest": "tsx scripts/src/cli.ts ingest",
    "parse": "tsx scripts/src/cli.ts parse",
    "extract": "tsx scripts/src/cli.ts extract",
    "verify": "tsx scripts/src/cli.ts verify",
    "diff": "tsx scripts/src/cli.ts diff",
    "blueprint": "tsx scripts/src/cli.ts blueprint",
    "pipeline": "tsx scripts/src/cli.ts pipeline",
    "eval": "tsx packages/evals/src/cli.ts",
    "dev": "pnpm --filter @assent/web run dev",
    "dev:web": "pnpm --filter @assent/web run dev",
    "dev:desktop": "pnpm --filter @assent/desktop run dev",
    "start": "pnpm --filter @assent/web start"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "overrides": {
      "@types/react": "18.3.12",
      "@types/react-dom": "18.3.1"
    }
  }
}
