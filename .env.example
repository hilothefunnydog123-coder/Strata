# ─── Assent environment ─────────────────────────────────────────────────────
# Copy to .env and fill in. Everything here has an offline-safe default so the
# whole pipeline runs with zero network access and zero secrets (PIPELINE_MODE=fixture).

# Pipeline execution mode.
#   fixture → read committed snapshots + committed LLM cache only. No network.
#             A cache miss FAILS LOUDLY (never fabricates). This is the default.
#   live    → fetch from sources (rate-limited, robots-respecting) and call the LLM.
PIPELINE_MODE=fixture

# Server database (Postgres). pgvector is optional; when absent, embeddings are
# stored as JSON and similarity is computed in-app. See packages/db/README.md.
DATABASE_URL=postgres://assent@127.0.0.1:5432/assent_dev

# Anthropic. Only required in PIPELINE_MODE=live.
ANTHROPIC_API_KEY=
# Model used for per-span extraction and diff classification.
ASSENT_EXTRACT_MODEL=claude-sonnet-4-6
# Higher-capability model, behind a flag, for blueprint frontier synthesis.
ASSENT_BLUEPRINT_MODEL=claude-sonnet-4-6

# Web app auth. Long random strings; generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=dev-only-change-me-to-a-long-random-string
# Issuer label shown in authenticator apps for TOTP.
TOTP_ISSUER=Assent

# Outbound email for the demo-request notification. Unset → notifications are
# written to the DB and logged to stdout instead of sent.
SMTP_URL=
DEMO_NOTIFY_TO=

# Crawler identity (sent as User-Agent in live mode). Include a real contact.
ASSENT_CRAWLER_CONTACT=coverage-ops@example.com
