# Medeal appeals platform: environment.
#
# Copy to .env.local for development. Never commit a filled-in .env file.
# Every variable below is read through lib/env.ts, which parses this set with Zod
# at startup. If a required variable is missing the process refuses to boot.
# No other file in the codebase reads process.env directly.

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. A host containing "neon.tech" selects the Neon
# serverless HTTP driver; anything else uses node-postgres. Required.
DATABASE_URL=postgres://medeal:medeal@127.0.0.1:5432/medeal_dev

# ─── Authentication ──────────────────────────────────────────────────────────
# Signing secret for sessions. Minimum 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
BETTER_AUTH_SECRET=
# Absolute origin better-auth issues cookies and callbacks against. Falls back to
# RENDER_EXTERNAL_URL, which Render sets in the running service, so on Render it
# may be left unset. Netlify's URL and DEPLOY_PRIME_URL are build variables and
# are absent at runtime, so on Netlify this must be set. A wrong origin here does
# not throw: it issues cookies nobody can use, and sign in silently fails.
BETTER_AUTH_URL=http://localhost:3000

# ─── Model access ────────────────────────────────────────────────────────────
# Anthropic API key. Only lib/llm/client.ts may use it.
ANTHROPIC_API_KEY=
# Set true ONLY when a signed Business Associate Agreement is in place AND the
# key above belongs to a HIPAA-ready Anthropic API organisation. A default
# organisation is not covered by a BAA. Required for PHI_MODE=live.
ANTHROPIC_BAA_CONFIRMED=false

# ─── PHI mode ────────────────────────────────────────────────────────────────
# synthetic: the only supported mode today. Uploads must be tagged synthetic,
#            a banner shows on every authenticated page, and the LLM boundary
#            refuses to transmit anything not marked synthetic.
# live:      requires ANTHROPIC_BAA_CONFIRMED=true and PHI_ENCRYPTION_KEY. The
#            app will not start in live mode without both.
PHI_MODE=synthetic

# Key material for AES-256-GCM encryption of clinical columns. Required in every
# mode, including synthetic, so the code path that protects real records is the
# one exercised daily. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# A value that base64 decodes to exactly 32 bytes is used as the key verbatim.
# Anything else of at least 32 characters is run through HKDF-SHA256 to produce
# the key, so a secret generated by a hosting platform works without anyone
# having to produce base64 by hand. Either way the derivation is deterministic:
# change this value and previously encrypted rows become unreadable.
# Must differ from BETTER_AUTH_SECRET: PHI gets its own key so that rotating or
# leaking a session secret does not expose clinical records.
PHI_ENCRYPTION_KEY=

# ─── Email ───────────────────────────────────────────────────────────────────
# Resend API key. Without it, outbound mail is recorded and left unsent rather
# than silently dropped, and demo requests remain queryable with notified_at null.
RESEND_API_KEY=
# Verified sender identity, for example: Medeal <appeals@yourdomain.com>
EMAIL_FROM=
# Where inbound demo requests are delivered.
DEMO_REQUEST_TO=hilothefunnydog123@gmail.com
# Physical mailing address printed in the footer of every outbound campaign
# message. CAN-SPAM requires a real postal address. Required to send campaigns.
MAILING_ADDRESS=

# ─── Document storage (Cloudflare R2, S3 API) ────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Development fallback. When R2 credentials are absent and this is set, uploads
# are written to this directory on local disk instead. Never set in production.
LOCAL_STORAGE_DIR=.storage

# ─── Platform ────────────────────────────────────────────────────────────────
# Email address of the operator account created by: pnpm provision:superadmin
SUPERADMIN_EMAIL=
# Public origin of the deployment, used in emails and unsubscribe links. Same
# fallback rules as BETTER_AUTH_URL above: optional on Render, required on
# Netlify.
APP_URL=http://localhost:3000
# Shared secret required by the cron route that drains the jobs table.
# Vercel sends it as the Authorization header.
CRON_SECRET=

# ─── Crawler identity ────────────────────────────────────────────────────────
# Sent as the User-Agent when fetching public government records. Include a real
# contact address so source operators can reach a human.
CRAWLER_CONTACT=
