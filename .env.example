# Medeal appeals platform: environment.
#
# Copy to .env.local for development. Never commit a filled-in .env file.
# Every variable below is read through lib/env.ts, which parses this set with Zod
# at startup. If a required variable is missing the process refuses to boot.
# No other file in the codebase reads process.env directly.

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. A host containing "neon.tech" selects the Neon
# serverless HTTP driver; anything else uses node-postgres. Required.
DATABASE_URL=postgres://medeal:medeal@127.0.0.1:5432/medeal_dev

# ─── Authentication ──────────────────────────────────────────────────────────
# Signing secret for sessions. Minimum 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
BETTER_AUTH_SECRET=
# Absolute origin better-auth issues cookies and callbacks against. Falls back to
# RENDER_EXTERNAL_URL, which Render sets in the running service, so on Render it
# may be left unset. Netlify's URL and DEPLOY_PRIME_URL are build variables and
# are absent at runtime, so on Netlify this must be set. A wrong origin here does
# not throw: it issues cookies nobody can use, and sign in silently fails.
BETTER_AUTH_URL=http://localhost:3000

# ─── Model access ────────────────────────────────────────────────────────────
# Model provider API key. Only lib/llm/client.ts may use it. It must belong to
# whichever provider MODEL_BASE_URL points at: a key from one provider sent to
# another is an HTTP 401, and that is the most common way this goes wrong.
#
# The default below is Groq, whose free tier needs no card and is fast enough to
# run the corpus stages end to end. Get one at https://console.groq.com/keys
MODEL_API_KEY=
# Set true ONLY when a signed Business Associate Agreement covers the account
# the key above belongs to. Required for PHI_MODE=live, and there is no
# override.
#
# Read this before setting it: a FREE tier is never acceptable for patient data.
# Free tiers generally allow the provider to use what you send them to improve
# their products, which is fine for fabricated documents and unlawful for a real
# record. Getting to live means a paid account under a provider BAA (Bedrock on
# AWS, Vertex AI on Google Cloud, or an enterprise agreement), not a flag flip.
MODEL_BAA_CONFIRMED=false
# Where to send the call. Any endpoint speaking the OpenAI chat completions
# shape, which is nearly all of them:
#
#   Groq        https://api.groq.com/openai/v1          (default, free tier)
#   Together    https://api.together.xyz/v1
#   Cerebras    https://api.cerebras.ai/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   OpenAI      https://api.openai.com/v1
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai
#   local       http://127.0.0.1:8080/v1                (llama.cpp, Ollama)
#
# Moving between them is this line plus MODEL_NAME. No code changes.
MODEL_BASE_URL=https://api.groq.com/openai/v1
# Which model, named as the provider above names it. Groq's current ids are at
# https://console.groq.com/docs/models and they do get retired; a retired id is
# an HTTP 404 naming the model, which is the clearest error in the whole stack.
MODEL_NAME=llama-3.3-70b-versatile
# The model corpus extraction uses, when it should differ from the one that
# drafts appeals. Unset means "the same one".
#
# Ingesting a manual chapter is hundreds of thousands of tokens of bulk reading,
# and on a free account that volume is the whole constraint: one CMS chapter
# measured at 216,000 tokens, which is more than a day's allowance on most free
# tiers for a large model. Drafting is a handful of calls per appeal.
#
# Pointing this at a small model is safe here for a specific reason and not a
# general one. No holding enters the corpus without its quote being found
# verbatim in the passage it cites, and one that fails is deleted. So a weaker
# model extracting holdings finds fewer of them, not wrong ones. Do not reach
# for the same trick on the drafting side, where nothing downstream can tell a
# weak argument from a strong one.
MODEL_NAME_CORPUS=
# Ask for JSON at the API level as well as in the prompt. Leave true unless the
# provider rejects the response_format field outright, which some proxies and
# older local servers do. Turning it off is safe: every response is parsed
# against a Zod schema either way.
MODEL_JSON_MODE=true
# Published price per million tokens, in cents. Reporting only: these drive the
# spend figures on the operator console and nothing else. They are wrong the day
# pricing changes and nothing will fail, so check them when you check the bill.
# Zero is correct for a free tier and makes the console honest about spending
# nothing; set the real numbers before a paid account, or the console will keep
# reporting zero while the bill grows.
MODEL_PRICE_INPUT_CENTS=0
MODEL_PRICE_OUTPUT_CENTS=0

# ─── PHI mode ────────────────────────────────────────────────────────────────
# synthetic: the only supported mode today. Uploads must be tagged synthetic,
#            a banner shows on every authenticated page, and the LLM boundary
#            refuses to transmit anything not marked synthetic.
# live:      requires MODEL_BAA_CONFIRMED=true and PHI_ENCRYPTION_KEY. The
#            app will not start in live mode without both.
PHI_MODE=synthetic

# Key material for AES-256-GCM encryption of clinical columns. Required in every
# mode, including synthetic, so the code path that protects real records is the
# one exercised daily. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# A value that base64 decodes to exactly 32 bytes is used as the key verbatim.
# Anything else of at least 32 characters is run through HKDF-SHA256 to produce
# the key, so a secret generated by a hosting platform works without anyone
# having to produce base64 by hand. Either way the derivation is deterministic:
# change this value and previously encrypted rows become unreadable.
# Must differ from BETTER_AUTH_SECRET: PHI gets its own key so that rotating or
# leaking a session secret does not expose clinical records.
PHI_ENCRYPTION_KEY=

# ─── Email ───────────────────────────────────────────────────────────────────
# Resend API key. Without it, outbound mail is recorded and left unsent rather
# than silently dropped, and demo requests remain queryable with notified_at null.
RESEND_API_KEY=
# Verified sender identity, for example: Medeal <appeals@yourdomain.com>
EMAIL_FROM=
# Where inbound demo requests are delivered.
DEMO_REQUEST_TO=hilothefunnydog123@gmail.com
# Physical mailing address printed in the footer of every outbound campaign
# message. CAN-SPAM requires a real postal address. Required to send campaigns.
MAILING_ADDRESS=

# ─── Document storage (Cloudflare R2, S3 API) ────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Development fallback. When R2 credentials are absent and this is set, uploads
# are written to this directory on local disk instead. Never set in production.
#
# One of these two is mandatory: either all four R2_* variables or this. The
# corpus pipeline stores the raw bytes of every fetched document before parsing
# it, so running the ingestion commands on a laptop needs this set even though
# nothing is being uploaded through the interface.
LOCAL_STORAGE_DIR=.storage

# ─── Platform ────────────────────────────────────────────────────────────────
# Email address of the operator account created by: pnpm provision:superadmin
SUPERADMIN_EMAIL=
# Public origin of the deployment, used in emails and unsubscribe links. Same
# fallback rules as BETTER_AUTH_URL above: optional on Render, required on
# Netlify.
APP_URL=http://localhost:3000
# Shared secret required by the cron route that drains the jobs table.
# Vercel sends it as the Authorization header.
CRON_SECRET=

# ─── Crawler identity ────────────────────────────────────────────────────────
# Sent as the User-Agent when fetching public government records. Include a real
# contact address so source operators can reach a human.
CRAWLER_CONTACT=
